{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./gradlew *)",
      "Bash(CUCUMBER_FILTER_TAGS=* ./gradlew *)",
      "Bash(npm ci)",
      "Bash(npm start)",
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(npx ng *)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright install chromium)",
      "Bash(npx prettier *)",
      "Bash(npx stylelint *)",
      "Bash(docker compose *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)"
    ],
    "ask": [
      "Bash(docker compose down*)",
      "Bash(docker compose * down*)",
      "Bash(docker compose config*)",
      "Bash(docker compose * config*)",
      "Bash(docker compose exec *)",
      "Bash(docker compose * exec *)",
      "Bash(docker compose run *)",
      "Bash(docker compose * run *)",
      "Bash(docker compose cp *)",
      "Bash(docker compose * cp *)",
      "Bash(docker compose rm *)",
      "Bash(docker compose * rm *)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(*.env)",
      "Read(!.env.example)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-main.js"
          }
        ]
      }
    ]
  }
}
