SPRING_PROFILES_ACTIVE=prod
# S profilem prod se web při prvním otevření zeptá na nastavení (/prvni-nastaveni) a uloží ho do databáze;
# hodnoty níže platí, dokud je průvodce nebo správa nepřepíše.

DB_NAME=novanadeje
DB_USERNAME=novanadeje
DB_PASSWORD=change-me

# Prázdný = backend si klíč vygeneruje sám do svazku backend-secrets
JWT_SECRET=

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
CONTACT_RECIPIENT=info@nfnn.cz
# Odesílatel všech e-mailů; prázdný = CONTACT_RECIPIENT
MAIL_FROM=
# Komu chodí měsíční přehled, dokud správce neuloží nastavení na /sprava/prehledy; prázdný = CONTACT_RECIPIENT
REPORT_RECIPIENT=

BANK_ACCOUNT_NUMBER=5544332217/2010
BANK_IBAN=CZ2620100000005544332217
BANK_RECIPIENT_NAME="Nadační fond Nová naděje"

# Token Fio API „Sledování účtu“ (jen čtení); prázdný nechá import plateb vypnutý
FIO_TOKEN=
# Jen pro první import hlouběji než 89 dní (datum RRRR-MM-DD), po odemčení historie ve Fio: Nastavení > API, zámek, platí 10 minut
FIO_HISTORY_FROM=
# Sběrné účty (platební brány), ze kterých se nikdy neučí účet dárce; čísla účtů oddělená čárkou, prázdné = žádné
PAIRING_EXCLUDED_ACCOUNTS=

# Kdo podepisuje potvrzení o daru; prázdné hodnoty nechají výchozí Pavel Znamenáček, předseda správní rady
RECEIPT_SIGNATORY_NAME=
RECEIPT_SIGNATORY_ROLE=
# Od kterého roku web vystavuje potvrzení o daru (starší dary přehled ukáže bez PDF); prázdná = 2026
RECEIPT_FIRST_YEAR=
# První správce se zadává v prvním nastavení (/prvni-nastaveni), ne tady.

# Adresa, na které návštěvníci web otevírají; z ní se skládá odkaz v e-mailu pro obnovu hesla. Musí odpovídat FRONTEND_PORT
PUBLIC_URL=http://localhost:8080

FRONTEND_PORT=8080
