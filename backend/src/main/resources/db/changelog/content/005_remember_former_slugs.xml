<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="005-remember-former-slugs" author="nfnn">
        <createTable tableName="content_former_slug">
            <column name="slug" type="varchar(80)">
                <constraints primaryKey="true" primaryKeyName="pk_content_former_slug" nullable="false"/>
            </column>
            <column name="news_id" type="uuid">
                <constraints foreignKeyName="fk_content_former_slug_news" references="content_news(id)" deleteCascade="true"/>
            </column>
            <column name="project_id" type="uuid">
                <constraints foreignKeyName="fk_content_former_slug_project" references="content_project(id)" deleteCascade="true"/>
            </column>
            <column name="replaced_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table content_former_slug add constraint ck_content_former_slug_one_target check ((news_id is null) &lt;&gt; (project_id is null))</sql>
        <createIndex tableName="content_former_slug" indexName="ix_content_former_slug_news">
            <column name="news_id"/>
        </createIndex>
        <createIndex tableName="content_former_slug" indexName="ix_content_former_slug_project">
            <column name="project_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
