<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="006-show-a-photo-in-about" author="nfnn">
        <createTable tableName="content_about">
            <column name="id" type="smallint">
                <constraints primaryKey="true" primaryKeyName="pk_content_about" nullable="false"/>
            </column>
            <column name="photo_media_id" type="uuid">
                <constraints foreignKeyName="fk_content_about_photo_media" references="content_media(id)"/>
            </column>
            <column name="photo_alt" type="varchar(200)"/>
            <column name="photo_caption" type="varchar(200)"/>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table content_about add constraint ck_content_about_singleton check (id = 1)</sql>
        <sql>alter table content_about add constraint ck_content_about_texts_need_photo
            check (photo_media_id is not null or (photo_alt is null and photo_caption is null))</sql>
        <createIndex tableName="content_about" indexName="ix_content_about_photo_media">
            <column name="photo_media_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
