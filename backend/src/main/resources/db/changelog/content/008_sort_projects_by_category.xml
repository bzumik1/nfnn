<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="008-sort-projects-by-category" author="nfnn">
        <addColumn tableName="content_project">
            <column name="category" type="varchar(16)" defaultValue="OTHER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>alter table content_project add constraint ck_content_project_category check (category in ('CHILDREN', 'ADULTS', 'ANIMALS', 'OTHER'))</sql>
    </changeSet>
</databaseChangeLog>
