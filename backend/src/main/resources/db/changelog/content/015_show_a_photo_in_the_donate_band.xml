<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="015-show-a-photo-in-the-donate-band" author="nfnn">
        <createTable tableName="content_donate_band">
            <column name="id" type="smallint">
                <constraints primaryKey="true" primaryKeyName="pk_content_donate_band" nullable="false"/>
            </column>
            <column name="photo_media_id" type="uuid">
                <constraints foreignKeyName="fk_content_donate_band_photo_media" references="content_media(id)"/>
            </column>
            <column name="photo_alt" type="varchar(200)"/>
            <column name="updated_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table content_donate_band add constraint ck_content_donate_band_singleton check (id = 1)</sql>
        <sql>alter table content_donate_band add constraint ck_content_donate_band_alt_needs_photo
            check (photo_media_id is not null or photo_alt is null)</sql>
        <createIndex tableName="content_donate_band" indexName="ix_content_donate_band_photo_media">
            <column name="photo_media_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
