<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="018-index-foreign-keys" author="nfnn">
        <createIndex tableName="donation_receipt" indexName="ix_donation_receipt_template">
            <column name="template_sha256"/>
        </createIndex>
        <createIndex tableName="donation_receipt" indexName="ix_donation_receipt_logo">
            <column name="logo_sha256"/>
        </createIndex>
        <createIndex tableName="donation_receipt" indexName="ix_donation_receipt_signature">
            <column name="signature_sha256"/>
        </createIndex>
        <createIndex tableName="donation_receipt" indexName="ix_donation_receipt_supersedes">
            <column name="supersedes_id"/>
        </createIndex>
        <createIndex tableName="donor_sender_account" indexName="ix_donor_sender_account_payment">
            <column name="learned_from_payment_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
