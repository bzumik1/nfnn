<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="021-register-receipt-signing-keys" author="nfnn">
        <createTable tableName="receipt_signing_key">
            <column name="key_id" type="varchar(8)">
                <constraints primaryKey="true" primaryKeyName="pk_receipt_signing_key" nullable="false"/>
            </column>
            <column name="public_key" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="registered_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="seal" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table receipt_signing_key add constraint ck_receipt_signing_key_public_key check (octet_length(public_key) = 32)</sql>
        <sql>alter table receipt_signing_key add constraint ck_receipt_signing_key_status check (status in ('active', 'revoked'))</sql>
    </changeSet>

</databaseChangeLog>
