<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="031-keep-bank-logo-images" author="nfnn">
        <createTable tableName="bank_logo_image">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_bank_logo_image" nullable="false"/>
            </column>
            <column name="sha256" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="webp" type="bytea">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table bank_logo_image add constraint ck_bank_logo_image_sha256 check (sha256 ~ '^[0-9a-f]{64}$')</sql>
        <sql>alter table bank_logo_image add constraint ck_bank_logo_image_webp check (octet_length(webp) between 1 and 65536)</sql>
    </changeSet>

    <changeSet id="031-show-bank-logos" author="nfnn">
        <createTable tableName="bank_logo">
            <column name="code" type="varchar(4)">
                <constraints primaryKey="true" primaryKeyName="pk_bank_logo" nullable="false"/>
            </column>
            <column name="source_url" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="image_id" type="uuid">
                <constraints foreignKeyName="fk_bank_logo_image" referencedTableName="bank_logo_image" referencedColumnNames="id"
                             unique="true" uniqueConstraintName="uq_bank_logo_image_id"/>
            </column>
            <column name="fetched_at" type="timestamp with time zone"/>
            <column name="checked_at" type="timestamp with time zone"/>
            <column name="last_failure" type="varchar(32)"/>
        </createTable>
        <sql>alter table bank_logo add constraint ck_bank_logo_code check (code ~ '^[0-9]{4}$')</sql>
        <sql>alter table bank_logo add constraint ck_bank_logo_source_url check (source_url ~ '^https://[!-~]+$')</sql>
        <sql>alter table bank_logo add constraint ck_bank_logo_image_fetched check ((image_id is null) = (fetched_at is null))</sql>
        <sql>alter table bank_logo add constraint ck_bank_logo_last_failure check (last_failure in ('status', 'redirected', 'timeout', 'unreachable', 'unknown-host',
            'non-public-address', 'too-large', 'unsupported-type', 'image-too-large', 'unreadable-image', 'interrupted'))</sql>
    </changeSet>

