<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="032-keep-account-balance" author="nfnn">
        <addColumn tableName="bank_import_state">
            <column name="balance_minor" type="bigint"/>
            <column name="balance_read_at" type="timestamp with time zone"/>
        </addColumn>
        <sql>
            alter table bank_import_state
                add constraint ck_bank_import_state_balance
                    check ((balance_minor is null) = (balance_read_at is null)) not valid;
            alter table bank_import_state validate constraint ck_bank_import_state_balance;
        </sql>
    </changeSet>

</databaseChangeLog>
