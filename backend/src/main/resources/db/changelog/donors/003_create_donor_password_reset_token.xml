<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="003-create-donor-password-reset-token" author="nfnn">
        <createTable tableName="donor_password_reset_token">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_donor_password_reset_token" nullable="false"/>
            </column>
            <column name="donor_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="secret_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_donor_password_reset_token_secret_hash"/>
            </column>
            <column name="issued_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamp with time zone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="donor_password_reset_token" baseColumnNames="donor_id"
                                 referencedTableName="donor" referencedColumnNames="id"
                                 constraintName="fk_donor_password_reset_token_donor" onDelete="CASCADE"/>
        <createIndex tableName="donor_password_reset_token" indexName="ix_donor_password_reset_token_donor">
            <column name="donor_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
