<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="010-add-passkeys" author="nfnn">
        <createTable tableName="donor_passkey">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_donor_passkey" nullable="false"/>
            </column>
            <column name="donor_id" type="uuid">
                <constraints nullable="false"/>
            </column>
            <column name="credential_id" type="varchar(1366)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_donor_passkey_credential_id"/>
            </column>
            <column name="credential_data" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="sign_count" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="transports" type="varchar(100)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="timestamp with time zone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="donor_passkey" baseColumnNames="donor_id"
                                 referencedTableName="donor" referencedColumnNames="id"
                                 constraintName="fk_donor_passkey_donor" onDelete="CASCADE"/>
        <createIndex tableName="donor_passkey" indexName="ix_donor_passkey_donor">
            <column name="donor_id"/>
            <column name="created_at"/>
        </createIndex>

        <createTable tableName="donor_passkey_challenge">
            <column name="id" type="uuid">
                <constraints primaryKey="true" primaryKeyName="pk_donor_passkey_challenge" nullable="false"/>
            </column>
            <column name="ceremony" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="donor_id" type="uuid"/>
            <column name="challenge_hash" type="varchar(64)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_donor_passkey_challenge_hash"/>
            </column>
            <column name="issued_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="timestamp with time zone"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="donor_passkey_challenge" baseColumnNames="donor_id"
                                 referencedTableName="donor" referencedColumnNames="id"
                                 constraintName="fk_donor_passkey_challenge_donor" onDelete="CASCADE"/>
        <createIndex tableName="donor_passkey_challenge" indexName="ix_donor_passkey_challenge_donor">
            <column name="donor_id"/>
        </createIndex>
        <createIndex tableName="donor_passkey_challenge" indexName="ix_donor_passkey_challenge_expires_at">
            <column name="expires_at"/>
        </createIndex>
        <sql>alter table donor_passkey_challenge add constraint ck_donor_passkey_challenge_ceremony
            check ((ceremony = 'REGISTRATION' and donor_id is not null) or (ceremony = 'SIGN_IN' and donor_id is null))</sql>
    </changeSet>

</databaseChangeLog>
