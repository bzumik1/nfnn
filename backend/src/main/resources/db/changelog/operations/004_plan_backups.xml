<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="004-plan-backups" author="nfnn">
        <createTable tableName="operations_backup_schedule">
            <column name="id" type="smallint">
                <constraints primaryKey="true" primaryKeyName="pk_operations_backup_schedule" nullable="false"/>
            </column>
            <column name="backup_time" type="time">
                <constraints nullable="false"/>
            </column>
            <column name="test_restore_day" type="smallint">
                <constraints nullable="false"/>
            </column>
            <column name="test_restore_time" type="time">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table operations_backup_schedule add constraint ck_operations_backup_schedule_singleton check (id = 1)</sql>
        <sql>alter table operations_backup_schedule add constraint ck_operations_backup_schedule_day check (test_restore_day between 1 and 7)</sql>
    </changeSet>

</databaseChangeLog>
