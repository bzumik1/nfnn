<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="005-confirm-backup-key" author="nfnn">
        <createTable tableName="operations_backup_key_confirmation">
            <column name="id" type="smallint">
                <constraints primaryKey="true" primaryKeyName="pk_operations_backup_key_confirmation" nullable="false"/>
            </column>
            <column name="key_fingerprint" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="confirmed_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
            <column name="confirmed_by" type="uuid"/>
        </createTable>
        <sql>alter table operations_backup_key_confirmation add constraint ck_operations_backup_key_confirmation_singleton check (id = 1)</sql>
    </changeSet>

</databaseChangeLog>
