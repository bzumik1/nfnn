<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <changeSet id="006-carry-settings-key" author="nfnn">
        <createTable tableName="operations_carried_settings_key">
            <column name="id" type="smallint">
                <constraints primaryKey="true" primaryKeyName="pk_operations_carried_settings_key" nullable="false"/>
            </column>
            <column name="wrapped" type="varchar(120)">
                <constraints nullable="false"/>
            </column>
            <column name="stored_at" type="timestamp with time zone">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>alter table operations_carried_settings_key add constraint ck_operations_carried_settings_key_singleton check (id = 1)</sql>
    </changeSet>

</databaseChangeLog>
