# Nastavení backendu. Na server jako /DATA/AppData/nfnn/env/backend.env (práva 600).
# Hodnoty piš bez uvozovek a bez mezer kolem =. Řádek s # na začátku se nepoužije.

# Klíč k podpisu přihlášení, aspoň 32 znaků. Vygeneruj: openssl rand -hex 32
JWT_SECRET=

# Token Fio API „Sledování účtu“. Prázdný = import plateb vypnutý.
FIO_TOKEN=

# SMTP pro e-maily (kontaktní formulář, obnova hesla). Prázdné = e-maily neodcházejí.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true

# Volitelné řádky. Bez nich platí výchozí hodnota, která je u každého uvedená
# (FIO_HISTORY_FROM a RECEIPT_SIGNATURE_IMAGE výchozí nemají). Jinou nastavíš tak,
# že smažeš # na začátku a hodnotu upravíš; prázdnou ji nenechávej.

# Odesílatel všech e-mailů; bez řádku se použije CONTACT_RECIPIENT.
#MAIL_FROM=info@novanadeje.cz
# Kam chodí zprávy z kontaktního formuláře.
#CONTACT_RECIPIENT=info@novanadeje.cz
# Adresa, na které návštěvníci web otevírají (odkazy v e-mailech).
#PUBLIC_URL=https://nfnn.znamenacek.duckdns.org
# Jen pro první import starší než 89 dní, po odemčení historie ve Fio (RRRR-MM-DD).
#FIO_HISTORY_FROM=2025-01-01
# Kdo podepisuje potvrzení o daru.
#RECEIPT_SIGNATORY_NAME=Pavel Znamenáček
#RECEIPT_SIGNATORY_ROLE=předseda správní rady
# Sken podpisu, soubor v /DATA/AppData/nfnn/config/; bez řádku potvrzení bez obrázku.
#RECEIPT_SIGNATURE_IMAGE=/config/signature.png
