# Nastavení backendu. Na server jako /DATA/AppData/nfnn/env/backend.env (práva 600).
# Hodnoty piš bez uvozovek a bez mezer kolem =. Řádek s # na začátku se nepoužije.

# Klíč k podpisu přihlášení, aspoň 32 znaků. Vygeneruj: openssl rand -hex 32
JWT_SECRET=

# Token Fio API „Sledování účtu“. Prázdný = import plateb vypnutý.
FIO_TOKEN=

# SMTP pro e-maily (kontaktní formulář, obnova hesla, měsíční přehled) přes Brevo účtu fondu (viz deploy/README.md, E-maily).
# MAIL_PASSWORD je SMTP klíč z Brevo → SMTP & API; bez něj e-maily neodcházejí.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=bebb0c001@smtp-brevo.com
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true

# Volitelné řádky. Bez nich platí výchozí hodnota, která je u každého uvedená
# (FIO_HISTORY_FROM, PAIRING_EXCLUDED_ACCOUNTS a RECEIPT_SIGNATURE_IMAGE výchozí nemají). Jinou nastavíš tak,
# že smažeš # na začátku a hodnotu upravíš; prázdnou ji nenechávej.

# Odesílatel všech e-mailů; bez řádku se použije CONTACT_RECIPIENT.
#MAIL_FROM=info@nfnn.cz
# Kam chodí zprávy z kontaktního formuláře.
#CONTACT_RECIPIENT=info@nfnn.cz
# Kam chodí měsíční přehled (dárci, dary, nespárované platby, stav importu z Fio); bez řádku se použije CONTACT_RECIPIENT.
#REPORT_RECIPIENT=info@nfnn.cz
# Adresa, na které návštěvníci web otevírají (odkazy v e-mailech).
#PUBLIC_URL=https://nfnn.znamenacek.duckdns.org
# Jen pro první import starší než 89 dní, po odemčení historie ve Fio (RRRR-MM-DD).
# ZimaOS ji v nastavení aplikace ukáže jako 2025-01-01 00:00:00 +0000 UTC; backend z toho vezme datum.
#FIO_HISTORY_FROM=2025-01-01
# Sběrné účty, ze kterých se platby bez VS nikomu nepřiřazují (číslo/kód banky, víc oddělených čárkou).
#PAIRING_EXCLUDED_ACCOUNTS=2400000002/2010
# Kdo podepisuje potvrzení o daru.
#RECEIPT_SIGNATORY_NAME=Pavel Znamenáček
#RECEIPT_SIGNATORY_ROLE=předseda správní rady
# Sken podpisu, soubor v /DATA/AppData/nfnn/config/; bez řádku potvrzení bez obrázku.
#RECEIPT_SIGNATURE_IMAGE=/config/signature.png
# Od kterého roku web vystavuje potvrzení o daru (starší dary přehled ukáže bez PDF).
#RECEIPT_FIRST_YEAR=2026
# První správce: e-mail registrovaného dárce (víc oddělených čárkou); roli dostane při startu backendu, další správce už přidá ve správě.
#ADMIN_EMAILS=spravce@example.cz
