{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint:styles": "stylelint \"src/app/**/*.scss\" \"src/styles/*.scss\" \"src/styles/ui/*.scss\" src/styles.scss && node scripts/check-themes.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.{mjs,html}\" \"*.{json,js,ts,mts}\" \".*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"e2e/**/*.ts\" \"scripts/**/*.{mjs,html}\" \"*.{json,js,ts,mts}\" \".*.json\"",
    "e2e": "playwright test",
    "e2e:devices": "playwright test --project='device-*'",
    "e2e:pwa": "playwright test --project=pwa",
    "e2e:install": "playwright install --with-deps --only-shell chromium webkit",
    "lint": "ng lint && tsc -p tsconfig.node.json && node --test scripts/*.test.mjs",
    "screens:compare": "node ../scripts/compare-screens.mjs",
    "errors:vocabulary": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/export-error-vocabulary.mjs",
    "edge:fallback": "node scripts/build-fallback-worker.mjs"
  },
  "private": true,
  "packageManager": "npm@11.11.1",
  "dependencies": {
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/localize": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@angular/service-worker": "22.2.4",
    "@noble/curves": "2.4.0",
    "hash-wasm": "4.12.0",
    "idb": "8.0.4",
    "jsqr": "1.4.0",
    "pdfkit": "0.20.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/compiler-cli": "^22.2.3",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "ajv": "8.20.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "6.2.6",
    "jsdom": "^30.1.3",
    "pdfjs-dist": "6.4.299",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "vite": "^8.3.5"
  }
}
