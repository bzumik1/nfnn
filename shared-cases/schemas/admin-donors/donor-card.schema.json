{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/admin-donors/donor-card.schema.json",
  "title": "Donor card cases: the rows and the device copy give the donor card of /sprava/darci/<id> without its bank accounts",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "$ref": "../defs/rows.schema.json",
          "required": ["chunks", "queries", "summary"],
          "properties": {
            "chunks": { "$ref": "../defs/admin-copy.schema.json#/$defs/chunks" },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["donor"],
                "additionalProperties": false,
                "properties": { "donor": { "$ref": "../defs/rows.schema.json#/$defs/alias" } }
              }
            },
            "summary": {
              "type": "object",
              "required": ["today", "receiptsAvailableFrom"],
              "additionalProperties": false,
              "properties": {
                "today": { "$ref": "../defs/rows.schema.json#/$defs/day" },
                "receiptsAvailableFrom": { "$ref": "../defs/rows.schema.json#/$defs/year" }
              }
            }
          },
          "unevaluatedProperties": false
        },
        "expected": {
          "type": "object",
          "required": ["answers"],
          "additionalProperties": false,
          "properties": {
            "answers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["donor", "donations", "receipts", "yearlyReceiptsAvailableThrough", "receiptsAvailableFrom"],
                "additionalProperties": false,
                "properties": {
                  "donor": { "$ref": "../sync/admin-manifest.schema.json#/$defs/donorRecordRow" },
                  "donations": {
                    "type": "object",
                    "required": ["items", "totalAmountMinor", "currency", "count"],
                    "additionalProperties": false,
                    "properties": {
                      "items": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "id",
                            "receiptNumber",
                            "receivedAt",
                            "amountMinor",
                            "currency",
                            "purpose",
                            "status",
                            "source",
                            "pairedBy",
                            "senderAccount",
                            "confirmedSymbol",
                            "accountVerification",
                            "receiptAvailable"
                          ],
                          "properties": {
                            "id": { "type": "string", "pattern": "^donation:[1-9][0-9]*$" },
                            "receiptNumber": { "oneOf": [{ "type": "string" }, { "type": "null" }] },
                            "receivedAt": { "$ref": "../defs/rows.schema.json#/$defs/day" },
                            "amountMinor": { "$ref": "../defs/rows.schema.json#/$defs/amountMinor" },
                            "currency": { "const": "CZK" },
                            "purpose": { "enum": ["Obecný příspěvek", "Ověření účtu"] },
                            "status": { "enum": ["RECEIVED", "REFUNDED"] },
                            "source": { "enum": ["BANK_TRANSFER", "MANUAL"] },
                            "pairedBy": { "enum": ["VARIABLE_SYMBOL", "SENDER_ACCOUNT", "CONFIRMED_SYMBOL", "MANUAL", null] },
                            "senderAccount": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/account" }, { "type": "null" }] },
                            "confirmedSymbol": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/variableSymbol" }, { "type": "null" }] },
                            "accountVerification": { "type": "boolean" },
                            "receiptAvailable": { "type": "boolean" }
                          }
                        }
                      },
                      "totalAmountMinor": { "type": "integer", "minimum": 0 },
                      "currency": { "const": "CZK" },
                      "count": { "$ref": "../defs/rows.schema.json#/$defs/count" }
                    }
                  },
                  "receipts": { "type": "array", "maxItems": 0 },
                  "yearlyReceiptsAvailableThrough": { "$ref": "../defs/rows.schema.json#/$defs/year" },
                  "receiptsAvailableFrom": { "$ref": "../defs/rows.schema.json#/$defs/year" }
                }
              }
            }
          }
        }
      }
    }
  }
}
