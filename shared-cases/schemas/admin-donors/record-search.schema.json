{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/admin-donors/record-search.schema.json",
  "title": "Donor record search cases: the rows and the device copy give the donors found to pair a payment",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "$ref": "../defs/rows.schema.json",
          "required": ["chunks", "queries"],
          "properties": {
            "chunks": { "$ref": "../defs/admin-copy.schema.json#/$defs/chunks" },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": ["query"],
                "additionalProperties": false,
                "properties": { "query": { "type": "string", "maxLength": 200 } }
              }
            }
          },
          "unevaluatedProperties": false
        },
        "expected": {
          "type": "object",
          "required": ["answers"],
          "additionalProperties": false,
          "properties": {
            "answers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["items"],
                "additionalProperties": false,
                "properties": {
                  "items": {
                    "type": "array",
                    "maxItems": 20,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["donorId", "name", "type", "variableSymbol", "companyIdentifier"],
                      "properties": {
                        "donorId": { "type": "string", "pattern": "^donor:[a-z][a-z0-9]*$" },
                        "name": { "type": "string" },
                        "type": { "enum": ["PERSON", "COMPANY"] },
                        "variableSymbol": { "$ref": "../defs/rows.schema.json#/$defs/variableSymbol" },
                        "companyIdentifier": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
