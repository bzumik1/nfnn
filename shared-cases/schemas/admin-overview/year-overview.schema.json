{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/admin-overview/year-overview.schema.json",
  "title": "Admin overview cases: database rows and the requested year give the year overview the administration is answered",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "$ref": "../defs/rows.schema.json",
          "required": ["year"],
          "properties": {
            "year": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/year" }, { "type": "null" }] }
          },
          "unevaluatedProperties": false
        },
        "expected": { "$ref": "#/$defs/overview" }
      }
    },
    "overview": {
      "type": "object",
      "required": ["year", "availableYears", "donorsRegistered", "newDonors", "givingDonors", "received", "paired", "unpaired", "months"],
      "additionalProperties": false,
      "properties": {
        "year": { "$ref": "../defs/rows.schema.json#/$defs/year" },
        "availableYears": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "../defs/rows.schema.json#/$defs/year" } },
        "donorsRegistered": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "newDonors": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "givingDonors": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "received": { "$ref": "#/$defs/tally" },
        "paired": { "$ref": "#/$defs/tally" },
        "unpaired": { "$ref": "#/$defs/tally" },
        "months": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/month" } }
      }
    },
    "month": {
      "type": "object",
      "required": ["month", "received", "newDonors", "givingDonors", "paired", "unpaired"],
      "additionalProperties": false,
      "properties": {
        "month": { "$ref": "../defs/rows.schema.json#/$defs/month" },
        "received": { "$ref": "#/$defs/tally" },
        "newDonors": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "givingDonors": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "paired": { "$ref": "#/$defs/tally" },
        "unpaired": { "$ref": "#/$defs/tally" }
      }
    },
    "tally": {
      "type": "object",
      "required": ["count", "totalMinor", "currency"],
      "additionalProperties": false,
      "properties": {
        "count": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "totalMinor": { "type": "integer", "minimum": 0 },
        "currency": { "const": "CZK" }
      }
    }
  }
}
