{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/admin-payments/list.schema.json",
  "title": "Administration payment list cases: the rows and the device copy give the payments of /sprava/platby for each query",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "$ref": "../defs/rows.schema.json",
          "required": ["chunks", "queries"],
          "properties": {
            "chunks": { "$ref": "../defs/admin-copy.schema.json#/$defs/chunks" },
            "queries": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "pairing": { "enum": ["unpaired", "paired"] },
                  "year": { "$ref": "../defs/rows.schema.json#/$defs/year" },
                  "query": { "type": "string", "maxLength": 100 },
                  "from": { "$ref": "../defs/rows.schema.json#/$defs/day" },
                  "to": { "$ref": "../defs/rows.schema.json#/$defs/day" },
                  "donor": { "$ref": "../defs/rows.schema.json#/$defs/alias" },
                  "offset": { "$ref": "../defs/rows.schema.json#/$defs/count" },
                  "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
                }
              }
            }
          },
          "unevaluatedProperties": false
        },
        "expected": {
          "type": "object",
          "required": ["answers"],
          "additionalProperties": false,
          "properties": {
            "answers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["year", "availableYears", "items", "total"],
                "additionalProperties": false,
                "properties": {
                  "year": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/year" }, { "type": "null" }] },
                  "availableYears": { "type": "array", "items": { "$ref": "../defs/rows.schema.json#/$defs/year" } },
                  "items": { "type": "array", "items": { "$ref": "../defs/admin-copy.schema.json#/$defs/paymentListItem" } },
                  "total": { "$ref": "../defs/rows.schema.json#/$defs/count" }
                }
              }
            }
          }
        }
      }
    }
  }
}
