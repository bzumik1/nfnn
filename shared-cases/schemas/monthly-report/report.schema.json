{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/monthly-report/report.schema.json",
  "title": "Monthly report cases: database rows, the month, the bank import state and the report settings give the compiled figures and the e-mail",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "type": "string", "minLength": 1 },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "$ref": "../defs/rows.schema.json",
          "required": ["month", "bankImport", "sections"],
          "properties": {
            "month": { "$ref": "../defs/rows.schema.json#/$defs/month" },
            "bankImport": {
              "type": "object",
              "required": ["lastAttemptedAt", "lastSucceededAt", "lastFailureKind"],
              "additionalProperties": false,
              "properties": {
                "lastAttemptedAt": { "$ref": "#/$defs/optionalInstant" },
                "lastSucceededAt": { "$ref": "#/$defs/optionalInstant" },
                "lastFailureKind": { "oneOf": [{ "$ref": "#/$defs/failureKind" }, { "type": "null" }] }
              }
            },
            "sections": {
              "type": "object",
              "required": ["donors", "donations", "unpairedPayments", "bankImport"],
              "additionalProperties": false,
              "properties": {
                "donors": { "type": "boolean" },
                "donations": { "type": "boolean" },
                "unpairedPayments": { "type": "boolean" },
                "bankImport": { "type": "boolean" }
              }
            }
          },
          "unevaluatedProperties": false
        },
        "expected": {
          "type": "object",
          "required": ["figures", "subject", "text"],
          "additionalProperties": false,
          "properties": {
            "figures": { "$ref": "#/$defs/figures" },
            "subject": { "type": "string", "minLength": 1 },
            "text": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          }
        }
      }
    },
    "figures": {
      "type": "object",
      "required": ["month", "donorsRegistered", "newDonorsInMonth", "receivedInMonth", "pairedInMonth", "unpairedInMonth", "receivedInYear", "bankImport"],
      "additionalProperties": false,
      "properties": {
        "month": { "$ref": "../defs/rows.schema.json#/$defs/month" },
        "donorsRegistered": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "newDonorsInMonth": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "receivedInMonth": { "$ref": "#/$defs/tally" },
        "pairedInMonth": { "$ref": "#/$defs/tally" },
        "unpairedInMonth": { "$ref": "#/$defs/tally" },
        "receivedInYear": { "$ref": "#/$defs/tally" },
        "bankImport": {
          "type": "object",
          "required": ["lastSucceededAt", "lastFailure"],
          "additionalProperties": false,
          "properties": {
            "lastSucceededAt": { "$ref": "#/$defs/optionalInstant" },
            "lastFailure": {
              "oneOf": [
                {
                  "type": "object",
                  "required": ["kind", "attemptedAt"],
                  "additionalProperties": false,
                  "properties": {
                    "kind": { "$ref": "#/$defs/failureKind" },
                    "attemptedAt": { "$ref": "../defs/rows.schema.json#/$defs/instant" }
                  }
                },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "tally": {
      "type": "object",
      "required": ["count", "totalMinor"],
      "additionalProperties": false,
      "properties": {
        "count": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "totalMinor": { "type": "integer", "minimum": 0 }
      }
    },
    "failureKind": { "type": "string", "pattern": "^[A-Z][A-Z_]*$" },
    "optionalInstant": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/instant" }, { "type": "null" }] }
  }
}
