{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/payment/spayd.schema.json",
  "title": "SPAYD cases: what GET /api/donations/payment-details serves and the payment's amount in hellers, variable symbol and purpose give the SPAYD text of its QR, or a refusal",
  "description": "The browser composes the text with spayd() (features/donations/spayd.ts) and runs every case; a refusal names the fields spayd() refuses. details names a case of payment/details.json, whose expected answer the browser holds; servedDetails is an answer in the same shape that the backend never gives, so its values may break the SPAYD text rules on purpose. The backend's DonationPurposeSharedCasesTest reads the account-verification cases. qr/payment.json holds the QR symbol of each text under the same case name.",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": { "$ref": "#/$defs/input" },
        "expected": { "oneOf": [{ "$ref": "#/$defs/text" }, { "$ref": "#/$defs/refusal" }] }
      }
    },
    "input": {
      "type": "object",
      "required": ["amountMinor"],
      "oneOf": [{ "required": ["details"] }, { "required": ["servedDetails"] }],
      "additionalProperties": false,
      "properties": {
        "details": { "type": "string", "minLength": 1 },
        "servedDetails": { "$ref": "#/$defs/servedDetails" },
        "amountMinor": { "type": "number" },
        "variableSymbol": { "type": "string" },
        "purpose": { "enum": ["DONATION", "ACCOUNT_VERIFICATION"] }
      }
    },
    "servedDetails": {
      "type": "object",
      "required": ["account", "currency", "messages", "accountVerificationAmountMinor"],
      "additionalProperties": false,
      "properties": {
        "account": {
          "type": "object",
          "required": ["number", "iban", "recipientName"],
          "additionalProperties": false,
          "properties": {
            "number": { "type": "string" },
            "iban": { "type": "string" },
            "recipientName": { "type": "string" }
          }
        },
        "currency": { "type": "string" },
        "messages": {
          "type": "object",
          "required": ["donation", "accountVerification"],
          "additionalProperties": false,
          "properties": {
            "donation": { "type": "string" },
            "accountVerification": { "type": "string" }
          }
        },
        "accountVerificationAmountMinor": { "type": "integer" }
      }
    },
    "text": {
      "type": "object",
      "required": ["spayd"],
      "additionalProperties": false,
      "properties": {
        "spayd": { "$ref": "../defs/spayd.schema.json" }
      }
    },
    "refusal": {
      "type": "object",
      "required": ["refused"],
      "additionalProperties": false,
      "properties": {
        "refused": {
          "type": "object",
          "required": ["fields"],
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["amountMinor", "variableSymbol", "details"] }
            }
          }
        }
      }
    }
  }
}
