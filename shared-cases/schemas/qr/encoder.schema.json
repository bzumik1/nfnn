{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/qr/encoder.schema.json",
  "title": "QR encoder cases: a text at a level gives its QR symbol",
  "description": "Texts in each mode at each level and at versions from 1 to 40, with the symbol ZXing 3.5.4 draws for them under the ISO-8859-1 hint. The backend encodes them through ZXing until slice 1.10; the browser's encoder runs every case from 1.3.",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "required": ["text", "errorCorrection"],
          "additionalProperties": false,
          "properties": {
            "text": { "type": "string", "maxLength": 7089, "pattern": "^[\\u0000-\\u00ff]*$" },
            "errorCorrection": { "enum": ["L", "M", "Q", "H"] }
          }
        },
        "expected": {
          "type": "object",
          "$ref": "../defs/qr-symbol.schema.json",
          "properties": {
            "mode": { "enum": ["NUMERIC", "ALPHANUMERIC", "BYTE"] }
          },
          "unevaluatedProperties": false
        }
      }
    }
  }
}
