{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/qr/totp.schema.json",
  "title": "TOTP QR cases: an otpauth URI gives its QR symbol",
  "description": "The URIs are those of totp/uri.json, under the same case names. The backend encodes them through ZXing until slice 1.10; the browser's encoder runs every case from 1.3.",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "required": ["uri"],
          "additionalProperties": false,
          "properties": {
            "uri": { "$ref": "../defs/otpauth-uri.schema.json" }
          }
        },
        "expected": {
          "type": "object",
          "$ref": "../defs/qr-symbol.schema.json",
          "properties": {
            "errorCorrection": { "const": "M" },
            "mode": { "const": "BYTE" },
            "eci": { "const": 1 }
          },
          "unevaluatedProperties": false
        }
      }
    }
  }
}
