{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/qr/totp.schema.json",
  "title": "TOTP QR cases: a test secret, the issuer and the account name give an otpauth URI and its QR symbol",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "required": ["secret", "issuer", "accountName"],
          "additionalProperties": false,
          "properties": {
            "secret": { "type": "string", "pattern": "^[A-Z2-7]{32}$" },
            "issuer": { "type": "string", "minLength": 1 },
            "accountName": { "type": "string", "minLength": 1 }
          }
        },
        "expected": {
          "$ref": "../defs/qr-symbol.schema.json",
          "required": ["uri"],
          "properties": {
            "uri": { "type": "string", "pattern": "^otpauth://totp/[^?]+\\?[a-z]+=[^&]*(&[a-z]+=[^&]*)*$" },
            "errorCorrection": { "const": "M" },
            "mode": { "const": "BYTE" },
            "eci": { "const": 1 }
          },
          "unevaluatedProperties": false
        }
      }
    }
  }
}
