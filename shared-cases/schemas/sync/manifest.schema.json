{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nfnn.cz/shared-cases/schemas/sync/manifest.schema.json",
  "title": "Donor sync manifest cases: database rows, the donor, the first receipt year and the last bank import give the donor's manifest with the rows of each chunk",
  "type": "object",
  "required": ["source", "logic", "cases"],
  "additionalProperties": false,
  "properties": {
    "source": { "$ref": "../defs/source.schema.json" },
    "logic": { "type": "string", "minLength": 1 },
    "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/case" } }
  },
  "$defs": {
    "case": {
      "type": "object",
      "required": ["name", "input", "expected"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "input": {
          "type": "object",
          "$ref": "../defs/rows.schema.json",
          "required": ["donor", "firstReceiptYear", "bankDataAsOf"],
          "properties": {
            "donor": { "$ref": "../defs/rows.schema.json#/$defs/alias" },
            "firstReceiptYear": {
              "$ref": "../defs/rows.schema.json#/$defs/year",
              "description": "The setting RECEIPT_FIRST_YEAR. The backend runner, whose context is configured once, refuses a case that names another year than its context."
            },
            "bankDataAsOf": {
              "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/instant" }, { "type": "null" }],
              "description": "The last successful bank import, bank_import_state.last_succeeded_at, or null when the bank was never read."
            }
          },
          "unevaluatedProperties": false
        },
        "expected": { "$ref": "#/$defs/manifest" }
      }
    },
    "manifest": {
      "type": "object",
      "required": ["subject", "summary", "chunks"],
      "additionalProperties": false,
      "properties": {
        "subject": { "type": "string", "pattern": "^donor:[a-z][a-z0-9]*$" },
        "summary": { "$ref": "#/$defs/summary" },
        "chunks": { "type": "array", "items": { "$ref": "#/$defs/donationsChunk" } }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "totalAmountMinor",
        "currency",
        "count",
        "lastReceivedAt",
        "byYear",
        "yearlyReceiptsAvailableThrough",
        "receiptsAvailableFrom",
        "bankDataAsOf"
      ],
      "additionalProperties": false,
      "properties": {
        "totalAmountMinor": { "type": "integer", "minimum": 0 },
        "currency": { "const": "CZK" },
        "count": { "$ref": "../defs/rows.schema.json#/$defs/count" },
        "lastReceivedAt": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/day" }, { "type": "null" }] },
        "byYear": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["year", "count", "totalAmountMinor"],
            "additionalProperties": false,
            "properties": {
              "year": { "$ref": "../defs/rows.schema.json#/$defs/year" },
              "count": { "$ref": "../defs/rows.schema.json#/$defs/count" },
              "totalAmountMinor": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "yearlyReceiptsAvailableThrough": { "$ref": "../defs/rows.schema.json#/$defs/year" },
        "receiptsAvailableFrom": { "$ref": "../defs/rows.schema.json#/$defs/year" },
        "bankDataAsOf": { "oneOf": [{ "$ref": "../defs/rows.schema.json#/$defs/instant" }, { "type": "null" }] }
      }
    },
    "donationsChunk": {
      "type": "object",
      "required": ["id", "rowsSha256", "count", "rows"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^donations:\\d{4}$" },
        "rowsSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "count": { "type": "integer", "minimum": 1 },
        "rows": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/donationRow" } }
      }
    },
    "donationRow": {
      "type": "object",
      "required": ["id", "receivedAt", "amountMinor", "currency", "status", "source", "purpose", "pairedBy", "bankAccountId", "symbolClaimId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^donation:[1-9][0-9]*$" },
        "receivedAt": { "$ref": "../defs/rows.schema.json#/$defs/day" },
        "amountMinor": { "$ref": "../defs/rows.schema.json#/$defs/amountMinor" },
        "currency": { "const": "CZK" },
        "status": { "enum": ["RECEIVED", "REFUNDED"] },
        "source": { "enum": ["BANK_TRANSFER", "MANUAL"] },
        "purpose": { "enum": ["GENERAL", "ACCOUNT_VERIFICATION"] },
        "pairedBy": { "enum": ["VARIABLE_SYMBOL", "SENDER_ACCOUNT", "CONFIRMED_SYMBOL", "MANUAL", null] },
        "bankAccountId": { "type": "null", "description": "The bank account a donation was paired through; the case rows hold none" },
        "symbolClaimId": { "type": "null", "description": "The confirmed older symbol a donation was paired by; the case rows hold none" }
      }
    }
  }
}
