{
  "source": "edited",
  "logic": "The otpauth:// URI that DonorSecondFactorService builds for a fixed test secret, the issuer and the account name (TotpSecret.otpauthUri); the secrets are test values, never used anywhere else. Only the backend computes it: the browser receives the URI from the API. qr/totp.json encodes each URI into its QR symbol under the same case name",
  "cases": [
    {
      "name": "a short address",
      "input": {
        "secret": "JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP",
        "issuer": "Nová naděje",
        "accountName": "jana@example.cz"
      },
      "expected": {
        "uri": "otpauth://totp/Nov%C3%A1%20nad%C4%9Bje:jana%40example.cz?secret=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP&issuer=Nov%C3%A1%20nad%C4%9Bje&algorithm=SHA1&digits=6&period=30"
      }
    },
