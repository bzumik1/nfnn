{
  "$schema": "https://t3.codes/schema/t3.json",
  "scripts": [
    {
      "name": "Setup worktree",
      "command": "bash scripts/setup-worktree.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Clean build output",
      "command": "bash scripts/clean-worktree.sh",
      "icon": "build",
      "runOnSettle": true
    },
    {
      "name": "Dev",
      "command": "cd frontend && npm start",
      "icon": "play",
      "stopOnSettle": true
    }
  ]
}
